{
    "name": "scrum-tools-server",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc --project ./tsconfig.json",
        "start": "node ./dist/index.js",
        "dev": "tsx watch ./index.ts",
        "knex": "knex --knexfile knexfile.cjs",
        "db:migrate:make": "npm run knex -- migrate:make",
        "db:migrate:latest": "npm run knex -- migrate:latest",
        "db:migrate:rollback": "npm run knex -- migrate:rollback",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --fix --report-unused-disable-directives --max-warnings 0"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.11.3",
        "socket.io": "^4.7.2",
        "uuid": "^11.1.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "jiti": "^2.6.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.14.0",
        "@types/pg": "^8.11.11",
        "@types/socket.io": "^3.0.1",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^4.1.0",
        "eslint": "^9.39.4",
        "eslint-plugin-import-x": "^4.16.2",
        "globals": "^17.4.0",
        "knex": "^3.1.0",
        "nodemon": "^3.0.1",
        "socket.io-client": "^4.8.1",
        "supertest": "^7.1.0",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.57.1",
        "vitest": "^4.1.0"
    }
}
